#!/usr/bin/env python3
"""Privacy-safe Antigravity lifecycle callback for AgentDiode."""

from __future__ import annotations

import json
import os
import socket
import sys
from datetime import datetime
from pathlib import Path

STATE_MAP = {
    "PreInvocation": "running",
    "PreToolUse": "running",
    "PostToolUse": "running",
    "PostInvocation": "running",
    "Stop": "completed",
}


def main() -> int:
    try:
        payload = json.load(sys.stdin)
        event_name = sys.argv[1]
        state = STATE_MAP[event_name]
        if payload.get("error"):
            state = "error"
        workspace_paths = payload.get("workspacePaths", [])
        cwd = workspace_paths[0] if isinstance(workspace_paths, list) and workspace_paths else ""
        tool_call = payload.get("toolCall")
        tool_name = tool_call.get("name") if isinstance(tool_call, dict) else None
        runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
        target = Path(os.environ.get("AGENTDIODE_SOCKET", runtime / "agentdiode/agentdiode.sock"))
        event = {
            "protocol_version": 1,
            "event": f"session.{state}",
            "timestamp": datetime.now().astimezone().isoformat(),
            "agent_id": "antigravity",
            "agent_name": "Antigravity",
            "session_id": payload["conversationId"],
            "cwd": cwd if isinstance(cwd, str) else "",
            "reliability": "partial",
            "source": "antigravity-official-hooks",
            "error_message": str(payload.get("error", ""))[:240] or None,
            "metadata": {
                "hook_event_name": event_name,
                "tool_name": tool_name,
                "termination_reason": payload.get("terminationReason"),
            },
        }
        request = json.dumps({"command": "event", "payload": event}).encode() + b"\n"
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1.5)
            client.connect(str(target))
            client.sendall(request)
            client.recv(65536)
    except (KeyError, ValueError, OSError, json.JSONDecodeError) as exc:
        print(f"agentdiode Antigravity hook: {exc}", file=sys.stderr)
    print("{}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
